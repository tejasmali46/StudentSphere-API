    {
      "name": "15. Get All Students After Deletion",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": ["{{baseUrl}}"],
          "path": ["api", "students"]
        },
        "description": "Verifies that the deleted record is no longer present."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Deleted student is absent from records\", function () {",
              "    const res = pm.response.json();",
              "    const currentId = pm.collectionVariables.get(\"studentId\");",
              "    const exists = res.data.some(s => (s.id === currentId || s._id === currentId));",
              "    pm.expect(exists).to.be.false;",
