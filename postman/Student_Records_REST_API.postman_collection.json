            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Email Student\",\n  \"rollNumber\": \"2309999\",\n  \"email\": \"invalid-email-address\",\n  \"course\": \"Computer Engineering\",\n  \"year\": 2\n}"
